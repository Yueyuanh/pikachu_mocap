    <child link="left_elbow_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="2.0" lower="-1.57" upper="1.57" velocity="2"/>
  </joint>
  <!-- elbow_link：手（末端） -->
  <link name="left_elbow_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.033"/>
      <geometry>
        <box size="0.03 0.03 0.066"/>
      </geometry>
      <material name="arm_elbow"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.033"/>
      <geometry>
        <box size="0.03 0.03 0.066"/>
      </geometry>
    </collision>
  </link>
  <!-- arm_pitch_link：pitch/roll 共点的关节标记 -->
  <link name="right_arm_pitch_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.0 0"/>
      <geometry>
        <box size="0.004 0.004 0.004"/>
      </geometry>
      <material name="arm_pitch"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0 0"/>
      <geometry>
        <box size="0.004 0.004 0.004"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_arm_roll_joint" type="revolute">
    <!-- pitch/roll 轴严格共点；rpy ±90° 使零位大臂沿 ±y 水平外展 -->
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0"/>
    <parent link="right_arm_pitch_link"/>
    <child link="right_arm_roll_link"/>
    <axis xyz="-1 0 0"/>
    <limit effort="2.0" lower="-1.57" upper="1.57" velocity="2"/>
  </joint>
  <!-- arm_roll_link：上臂段（arm_upper_z） -->
  <link name="right_arm_roll_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
      <material name="arm_roll"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_arm_yaw_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.05"/>
    <parent link="right_arm_roll_link"/>
    <child link="right_arm_yaw_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="2.0" lower="-1.57" upper="1.57" velocity="2"/>
  </joint>
  <!-- arm_yaw_link：下臂段（arm_lower_z） -->
  <link name="right_arm_yaw_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
      <material name="arm_yaw"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_elbow_joint" type="revolute">
    <!-- rpy 清零：去除原折弯，默认手与前臂连成直线（展开） -->
    <origin rpy="0 0 0" xyz="0 0 -0.05"/>
    <parent link="right_arm_yaw_link"/>
    <child link="right_elbow_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" lower="-1.57" upper="1.57" velocity="2"/>
  </joint>
  <!-- elbow_link：手（末端） -->
  <link name="right_elbow_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.033"/>
      <geometry>
        <box size="0.03 0.03 0.066"/>
      </geometry>
      <material name="arm_elbow"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.033"/>
      <geometry>
        <box size="0.03 0.03 0.066"/>
      </geometry>
    </collision>
  </link>
  <!-- ear_pitch_link：空连杆（无 box，仅作两个 DOF 的中继节点，位于耳根） -->
  <link name="left_ear_pitch_link">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.004"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_ear_roll_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="left_ear_pitch_link"/>
    <child link="left_ear_roll_link"/>
    <!-- 轴改 x：真正绕前后横轴 roll（耳朵左右倒伏/张开）；原 0 0 z 是 yaw -->
    <axis xyz="1 0 0"/>
    <limit effort="1.0" lower="-0.6" upper="0.8" velocity="2"/>
  </joint>
  <!-- ear_roll_link：耳朵唯一 box，长度=耳全长 ear_len，从头顶竖直伸出 -->
  <link name="left_ear_roll_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0425"/>
      <geometry>
        <box size="0.018 0.028 0.085"/>
      </geometry>
      <material name="ear_yellow"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0425"/>
      <geometry>
        <box size="0.018 0.028 0.085"/>
      </geometry>
    </collision>
  </link>
  <!-- ear_pitch_link：空连杆（无 box，仅作两个 DOF 的中继节点，位于耳根） -->
  <link name="right_ear_pitch_link">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.004"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_ear_roll_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="right_ear_pitch_link"/>
    <child link="right_ear_roll_link"/>
    <!-- 轴改 x：真正绕前后横轴 roll（耳朵左右倒伏/张开）；原 0 0 z 是 yaw -->
    <axis xyz="1 0 0"/>
    <limit effort="1.0" lower="-0.6" upper="0.8" velocity="2"/>
  </joint>
  <!-- ear_roll_link：耳朵唯一 box，长度=耳全长 ear_len，从头顶竖直伸出 -->
  <link name="right_ear_roll_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0425"/>
      <geometry>
        <box size="0.018 0.028 0.085"/>
      </geometry>
      <material name="ear_yellow"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0425"/>
      <geometry>
        <box size="0.018 0.028 0.085"/>
      </geometry>
    </collision>
  </link>
</robot>
