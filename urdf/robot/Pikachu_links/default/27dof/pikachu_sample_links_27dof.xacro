<?xml version="1.0"?>
<!-- ============================================================================
  Pikachu_V025 简化模型 —— 纯 box 连杆，无 mesh
  ============================================================================
  · 层级、关节原点(xyz/rpy)、旋转轴 均严格对应 urdf/Pikachu_V025.urdf
  · 每个连杆用 <box> 表示，尺寸/偏移全部参数化，改顶部参数即可整体适配骨骼
  · 单位：米 (m)

  与原始 URDF 的对应总表：
    base_link           → 躯干
    left/right_hip_pitch→hip_roll   原点沿 y (横向) 偏移 hip_pitch_to_roll_y
    left/right_hip_roll →hip_yaw    原点沿 -z 偏移 hip_roll_to_yaw_z
    left/right_hip_yaw  →knee       原点沿 -z 偏移 thigh_length   （大腿）
    left/right_knee     →ankle      原点沿 -z 偏移 shank_length   （小腿）
    left/right_arm_pitch→roll       可动(revolute)，沿 y 偏移 arm_pitch_to_roll_y
    left/right_arm_roll →yaw        可动(revolute)，沿 -z 偏移 arm_upper_z
    left/right_arm_yaw  →elbow      可动(revolute)，沿 -z 偏移 arm_lower_z
    base_link → head_pitch→yaw→roll 头部三段(3 DOF：pitch点头 / yaw转头 / roll歪头)，
                                    立在躯干顶 shoulder_height 之上
    head_roll_link → 左/右耳  ear_pitch→ear_roll（每耳 2 DOF，头顶两侧）
    base_link → 尾巴         tail_pitch→tail_yaw（2 DOF，躯干背面伸出）


    工程测量定义（零位 / T-pose，不用 box 对角线代替关节轴距）：
      M01 耳高：       base_link 原点→ear_pitch 轴的 z 差       = 0.449 (=0.166+0.283)
      M02 耳半宽：     中心 z 轴→ear_pitch 轴的 |y|             = 0.116
      M03 头轴高：     base_link 原点→head_pitch 轴的 z 差      = 0.219 (=0.166+0.053)
      M04 肩半宽：     中心 z 轴→arm_pitch/arm_roll 共点的 |y| = 0.116
      M05 手臂前向偏置：腿关节平面→肩关节平面的 x 差          = 0.083
      M06 大臂长：     arm_pitch/arm_roll 共点→elbow 轴的欧氏距离 = 0.100
      M07 小臂长：     elbow 轴→elbow_link 几何远端             = 0.066
      M08 髋半宽：     中心 z 轴→hip_roll 轴的 |y|              = 0.100
      M09 躯干长：     hip_pitch 轴→arm_pitch 轴的 z 差          = 0.166
      M10 大腿长：     hip_pitch 轴→knee 轴的 z 差               = 0.083
      M11 小腿长：     knee 轴→ankle 轴的 z 差                  = 0.086
      M12 脚长：       ankle_link 的 box x 边长                       = 0.093
      M13 尾轴高：     ankle 轴→tail_pitch 轴的 z 差             = 0.166
      M14 尾部偏置：   腿关节平面→tail box 中心的 |x|              = 0.143

    上述 14 项由 measure_* 主参数唯一驱动；tuner 按同一定义实测并做容差闭环。

    DOF 合计：腿 10 + 臂 8 + 头 3 + 耳 4 + 尾 2 = 27
    注：臂 pitch/roll/yaw/elbow 与 head 原本为 fixed，这里改成 revolute 以便驱动；
        限位由 arm_lim_* / head_lim_* 控制。
============================================================================ -->
<robot name="pikachu_sample_links" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- ① 工程主参数：14 项测量的唯一真相源（SI 单位：m）       -->
  <!-- ============================================================ -->
  <xacro:property name="tune_profile" value="pikachu_27dof_v1"/>
  <xacro:property name="tune_measurement_tolerance" value="0.0005"/>

  <xacro:property name="measure_ear_root_height"             value="0.449"/>
  <xacro:property name="measure_ear_root_half_width"         value="0.116"/>
  <xacro:property name="measure_head_pitch_height"           value="0.219"/>
  <xacro:property name="measure_shoulder_half_width"         value="0.116"/>
  <xacro:property name="measure_arm_plane_offset_x"          value="0.083"/>
  <xacro:property name="measure_upper_arm_length"            value="0.100"/>
  <xacro:property name="measure_forearm_length"              value="0.066"/>
  <xacro:property name="measure_hip_roll_half_width"         value="0.100"/>
  <xacro:property name="measure_torso_length"                value="0.166"/>
  <xacro:property name="measure_thigh_length"                value="0.083"/>
  <xacro:property name="measure_shank_length"                value="0.086"/>
  <xacro:property name="measure_foot_length_x"               value="0.093"/>
  <xacro:property name="measure_tail_axis_height_from_ankle" value="0.166"/>
  <xacro:property name="measure_tail_center_offset_x"        value="0.143"/>

  <!-- ============================================================ -->
  <!-- ② 派生参数：宏只引用这些别名；禁止在下游重复写测量常量 -->
  <!-- ============================================================ -->
  <xacro:property name="shoulder_width"     value="${measure_shoulder_half_width}"/>
  <xacro:property name="arm_forward_offset" value="${measure_arm_plane_offset_x}"/>
  <xacro:property name="upper_arm_len"      value="${measure_upper_arm_length}"/>
  <xacro:property name="lower_arm_len"      value="${measure_forearm_length}"/>
  <xacro:property name="torso_len"          value="${measure_torso_length}"/>
  <xacro:property name="thigh_len"          value="${measure_thigh_length}"/>
  <xacro:property name="shank_len"          value="${measure_shank_length}"/>
  <xacro:property name="foot_len"           value="${measure_foot_length_x}"/>
  <xacro:property name="hip_width"          value="${measure_hip_roll_half_width}"/>
  <xacro:property name="head_height"        value="${measure_head_pitch_height}"/>
  <xacro:property name="ear_height"         value="${measure_ear_root_height}"/>

  <!-- arm_pitch 与 arm_roll 轴严格共点；不再用隐含的 20 mm 肩连杆抵消肩宽。 -->
  <xacro:property name="arm_pitch_to_roll_y" value="${0.0}"/>
  <xacro:property name="arm_y_offset"   value="${shoulder_width}"/>
  <xacro:property name="arm_x_offset"   value="${arm_forward_offset}"/>
  <xacro:property name="arm_upper_z"    value="${upper_arm_len/2.0}"/>
  <xacro:property name="arm_lower_z"    value="${upper_arm_len/2.0}"/>
  <xacro:property name="shoulder_height" value="${torso_len}"/>

  <!-- hip_pitch→knee 的 z 差由髋部下段与大腿段各承担一半。 -->
  <xacro:property name="thigh_length"   value="${thigh_len/2.0}"/>
  <xacro:property name="shank_length"   value="${shank_len}"/>
  <xacro:property name="foot_len_x"     value="${foot_len}"/>

  <!-- ankle 轴 z=-(thigh+shank)，因此 tail_root_z 可严格闭环 M13。 -->
  <xacro:property name="tail_root_z" value="${-thigh_len - shank_len + measure_tail_axis_height_from_ankle}"/>

  <!-- ============================================================ -->
  <!-- ③ 其他细则：厚度 / 局部偏移 / 限位 / 尺寸 / 材质，按部件分区   -->
  <!-- ============================================================ -->
  <!-- base -->
  <xacro:property name="pelvis_half_width" value="0.06"/>
    <!-- 骨盆半宽：躯干盒 y 宽 = 2×此（髋关节定位现由①hip_width 独立，与此解耦） -->
  <xacro:property name="torso_len_x"       value="0.2"/>
    <!-- 躯干盒 x(前后) 厚度 -->
  <!-- leg -->
  <xacro:property name="hip_pitch_to_roll_y" value="0.0355"/>
    <!-- hip_pitch→hip_roll 关节沿 y 偏移（骨盆横向段） -->
  <xacro:property name="hip_roll_to_yaw_z"   value="${thigh_len/2}"/>
    <!-- hip_roll→hip_yaw 关节沿 -z 偏移（骨盆下沿段）；与大腿段对分 hip_pitch→knee 总长 -->
  <xacro:property name="leg_thick_x" value="0.04"/>
    <!-- 腿 box x(前后) 厚 -->
  <xacro:property name="leg_width_y" value="0.025"/>
    <!-- 腿 box y(内外) 厚 -->
  <xacro:property name="foot_wid_y" value="0.05"/>
  <xacro:property name="foot_hgt_z" value="0.02"/>
    <!-- 脚 宽 / 高 -->
  <!-- arm -->
  <xacro:property name="joint_marker_size" value="0.004"/>
    <!-- 共点串联关节的数值稳定用小盒；不参与人体尺寸定义 -->
  <xacro:property name="arm_thick_x" value="0.03"/>
  <xacro:property name="arm_width_y" value="0.03"/>
    <!-- 臂 box x / y 厚 -->
  <xacro:property name="arm_lim_min" value="-1.57"/>
  <xacro:property name="arm_lim_max" value="1.57"/>
    <!-- 臂 pitch/roll/yaw/elbow 关节限位（弧度） -->
  <!-- head -->
  <xacro:property name="head_len_x"         value="0.15"/>
  <xacro:property name="head_wid_y"         value="0.15"/>
  <xacro:property name="head_hgt_z"         value="0.15"/>
    <!-- 头 长/宽/高 -->
  <!-- 头底部(转轴) 相对躯干顶的抬升 = 头高 - 躯干长（不含 box 半高，box 尺寸独立） -->
  <xacro:property name="head_bottom_offset" value="${head_height - shoulder_height}"/>
  <xacro:property name="head_lim_min" value="-0.8"/>
  <xacro:property name="head_lim_max" value="0.8"/>
    <!-- 头关节限位（弧度） -->
  <!-- ear -->
  <xacro:property name="ear_off_y"   value="${measure_ear_root_half_width}"/>
  <xacro:property name="ear_len"     value="0.085"/>
  <xacro:property name="ear_thick_x" value="0.018"/>
  <xacro:property name="ear_width_y" value="0.028"/>
  <xacro:property name="ear_lim_min" value="-0.6"/>
  <xacro:property name="ear_lim_max" value="0.8"/>
    <!-- 耳朵 横向偏移 / 全长 / 厚 / 宽 / 限位 -->
  <xacro:property name="ear_root_z" value="${ear_height - head_height}"/>
    <!-- 耳根相对 head_roll_link 原点(头底部中心/转轴) 的 z 抬升 = 耳高 - 头高；只抬升耳朵，头保持原位 -->
  <!-- tail -->
  <xacro:property name="tail_len"   value="0.095"/>
  <xacro:property name="tail_wid"   value="0.050"/>
  <xacro:property name="tail_thick" value="0.02"/>
  <xacro:property name="tail_lim_min" value="-1.2"/>
  <xacro:property name="tail_lim_max" value="1.2"/>
    <!-- 尾 box 全长 / 横向宽 / 厚 / 限位 -->
  <xacro:property name="tail_root_x" value="${-measure_tail_center_offset_x + tail_len/2.0}"/>
    <!-- 尾根位置由“尾 box 中心偏置”反推：root_x-tail_len/2 = -M14 -->
  <!-- ============ link box 边长（解耦：box 尺寸现独立；box 中心位置仍由①②关节距离定位） ============ -->
  <!-- 躯干 box -->
  <xacro:property name="torso_wid_y" value="${pelvis_half_width*2}"/>
    <!-- 躯干盒 y 宽 = 骨盆半宽×2 -->
  <xacro:property name="torso_hgt_z" value="${shoulder_height}"/>
    <!-- 躯干盒 z 高 = 躯干长（肩高） -->
  <!-- 腿 box 各段长（截面 leg_thick_x / leg_width_y 见上） -->
  <xacro:property name="leg_hip_pitch_box_len" value="${hip_pitch_to_roll_y}"/>
    <!-- hip_pitch_link 横向(y)边长 -->
  <xacro:property name="leg_hip_roll_box_len"  value="${hip_roll_to_yaw_z}"/>
    <!-- hip_roll_link 骨盆段 z 边长 -->
  <xacro:property name="leg_thigh_box_len"     value="${thigh_length}"/>
    <!-- hip_yaw_link 大腿段 z 边长 -->
  <xacro:property name="leg_shank_box_len"     value="${shank_length}"/>
    <!-- knee_link 小腿段 z 边长 -->
  <!-- 臂 box 各段长（截面 arm_thick_x / arm_width_y 见上） -->
  <xacro:property name="arm_pitch_box_len" value="${joint_marker_size}"/>
    <!-- arm_pitch_link 是 pitch/roll 共点的小型关节标记，不占用大臂长 -->
  <xacro:property name="arm_roll_box_len"  value="${arm_upper_z}"/>
    <!-- arm_roll_link 大臂 roll 段 z 边长 -->
  <xacro:property name="arm_yaw_box_len"   value="${arm_lower_z}"/>
    <!-- arm_yaw_link 大臂 yaw 段 z 边长 -->
  <xacro:property name="arm_elbow_box_len" value="${lower_arm_len}"/>
    <!-- elbow_link 小臂(手)段 z 边长 = 小臂长 -->

  <!-- 材质（仅便于视觉区分；相邻关节不同色，左右对称） -->
  <xacro:property name="mat_torso"   value="0.55 0.60 0.75 1"/>
    <!-- 躯干：淡蓝灰 -->
  <xacro:property name="mat_arm_pitch"     value="0.75 0.35 1.00 1"/>
    <!-- 臂段A(arm_pitch 肩)：紫 -->
  <xacro:property name="mat_arm_roll"      value="1.00 0.90 0.25 1"/>
    <!-- 臂段B(arm_roll 上臂)：黄 -->
  <xacro:property name="mat_arm_yaw"       value="0.30 0.85 0.80 1"/>
    <!-- 臂段C(arm_yaw 下臂)：青 -->
  <xacro:property name="mat_arm_elbow"     value="1.00 0.45 0.55 1"/>
    <!-- 臂段D(elbow 手)：珊瑚 -->
  <xacro:property name="mat_leg_hip_pitch" value="0.90 0.35 0.80 1"/>
    <!-- 腿段A(hip_pitch)：品红 -->
  <xacro:property name="mat_leg_hip_roll"  value="1.00 0.60 0.20 1"/>
    <!-- 腿段B(hip_roll)：橙 -->
  <xacro:property name="mat_leg_hip_yaw"   value="0.35 0.55 1.00 1"/>
    <!-- 腿段C(hip_yaw 大腿)：蓝 -->
  <xacro:property name="mat_leg_knee"      value="0.30 0.80 0.35 1"/>
    <!-- 腿段D(knee 小腿)：绿 -->
  <xacro:property name="mat_leg_ankle"     value="0.25 0.28 0.35 1"/>
    <!-- 腿段E(ankle 脚)：深灰蓝 -->
  <xacro:property name="mat_head"    value="0.98 0.85 0.30 1"/>
    <!-- 头：亮黄 -->
  <xacro:property name="mat_ear"         value="0.95 0.78 0.25 1"/>
    <!-- 耳朵：亮黄 -->
  <xacro:property name="mat_tail"        value="0.55 0.38 0.18 1"/>
    <!-- 尾巴：棕 -->

  <!-- ============================================================ -->
  <!-- 材质定义（每段独立颜色，左右对称共用同一套）              -->
  <!-- ============================================================ -->
  <material name="torso_blue">
    <color rgba="${mat_torso}"/>
  </material>
  <material name="arm_pitch">
    <color rgba="${mat_arm_pitch}"/>
  </material>
  <material name="arm_roll">
    <color rgba="${mat_arm_roll}"/>
  </material>
  <material name="arm_yaw">
    <color rgba="${mat_arm_yaw}"/>
  </material>
  <material name="arm_elbow">
    <color rgba="${mat_arm_elbow}"/>
  </material>
  <material name="leg_hip_pitch">
    <color rgba="${mat_leg_hip_pitch}"/>
  </material>
  <material name="leg_hip_roll">
    <color rgba="${mat_leg_hip_roll}"/>
  </material>
  <material name="leg_hip_yaw">
    <color rgba="${mat_leg_hip_yaw}"/>
  </material>
  <material name="leg_knee">
    <color rgba="${mat_leg_knee}"/>
  </material>
  <material name="leg_ankle">
    <color rgba="${mat_leg_ankle}"/>
  </material>
  <material name="head_yellow">
    <color rgba="${mat_head}"/>
  </material>
  <material name="ear_yellow">
    <color rgba="${mat_ear}"/>
  </material>
  <material name="tail_brown">
    <color rgba="${mat_tail}"/>
  </material>

  <!-- ============================================================ -->
  <!-- 腿部宏：生成 pitch/roll/yaw/knee/ankle 五个 link             -->
  <!--   side: left | right     sn:  1 | -1（y 方向符号）      -->
  <!-- ============================================================ -->
  <xacro:macro name="leg_links" params="side sn">
    <!-- hip_pitch_link：覆盖到 roll 的横向(y)段 -->
    <link name="${side}_hip_pitch_link">
      <visual>
        <origin xyz="0 ${sn*hip_pitch_to_roll_y/2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_hip_pitch_box_len} ${leg_width_y}"/>
        </geometry>
        <material name="leg_hip_pitch"/>
      </visual>
<collision>
        <origin xyz="0 ${sn*hip_pitch_to_roll_y/2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_hip_pitch_box_len} ${leg_width_y}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_hip_roll_joint" type="revolute">
      <origin xyz="0 ${sn*hip_pitch_to_roll_y} 0" rpy="0 0 0"/>
      <parent link="${side}_hip_pitch_link"/>
      <child  link="${side}_hip_roll_link"/>
      <axis xyz="${sn} 0 0"/>
      <limit lower="-0.09" upper="0.26" effort="9.0" velocity="1"/>
    </joint>

    <!-- hip_roll_link：覆盖到 yaw 的 -z 骨盆段 -->
    <link name="${side}_hip_roll_link">
      <visual>
        <origin xyz="0 0 ${-hip_roll_to_yaw_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${leg_hip_roll_box_len}"/>
        </geometry>
        <material name="leg_hip_roll"/>
      </visual>
<collision>
        <origin xyz="0 0 ${-hip_roll_to_yaw_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${leg_hip_roll_box_len}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_hip_yaw_joint" type="revolute">
      <origin xyz="0 0 ${-hip_roll_to_yaw_z}" rpy="0 0 0"/>
      <parent link="${side}_hip_roll_link"/>
      <child  link="${side}_hip_yaw_link"/>
      <axis xyz="0 0 ${sn}"/>
      <limit lower="-0.09" upper="0.26" effort="9.0" velocity="1"/>
    </joint>

    <!-- hip_yaw_link：大腿段（thigh_length） -->
    <link name="${side}_hip_yaw_link">
      <visual>
        <origin xyz="0 0 ${-thigh_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${leg_thigh_box_len}"/>
        </geometry>
        <material name="leg_hip_yaw"/>
      </visual>
<collision>
        <origin xyz="0 0 ${-thigh_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${leg_thigh_box_len}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_knee_joint" type="revolute">
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
      <parent link="${side}_hip_yaw_link"/>
      <child  link="${side}_knee_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.57" effort="12.5" velocity="3"/>
    </joint>

    <!-- knee_link：小腿段（shank_length） -->
    <link name="${side}_knee_link">
      <visual>
        <origin xyz="0 0 ${-shank_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${leg_shank_box_len}"/>
        </geometry>
        <material name="leg_knee"/>
      </visual>
<collision>
        <origin xyz="0 0 ${-shank_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${leg_shank_box_len}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_ankle_joint" type="revolute">
      <origin xyz="0 0 ${-shank_length}" rpy="0 0 0"/>
      <parent link="${side}_knee_link"/>
      <child  link="${side}_ankle_link"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-0.52" upper="1.05" effort="9.0" velocity="2"/>
    </joint>

    <!-- ankle_link：脚掌（末端） -->
    <link name="${side}_ankle_link">
      <visual>
        <origin xyz="${foot_len_x/6.0} 0 ${-foot_hgt_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${foot_len_x} ${foot_wid_y} ${foot_hgt_z}"/>
        </geometry>
        <material name="leg_ankle"/>
      </visual>
<collision>
        <origin xyz="${foot_len_x/6.0} 0 ${-foot_hgt_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${foot_len_x} ${foot_wid_y} ${foot_hgt_z}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- 手臂宏：生成 pitch/roll/yaw/elbow 四个 link（全部 revolute 可动） -->
  <!-- ============================================================ -->
  <xacro:macro name="arm_links" params="side sn">
    <!-- arm_pitch_link：pitch/roll 共点的关节标记 -->
    <link name="${side}_arm_pitch_link">
      <visual>
        <origin xyz="0 ${sn*arm_pitch_to_roll_y/2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_pitch_box_len} ${arm_pitch_box_len} ${arm_pitch_box_len}"/>
        </geometry>
        <material name="arm_pitch"/>
      </visual>
<collision>
        <origin xyz="0 ${sn*arm_pitch_to_roll_y/2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_pitch_box_len} ${arm_pitch_box_len} ${arm_pitch_box_len}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_arm_roll_joint" type="revolute">
      <!-- pitch/roll 轴严格共点；rpy ±90° 使零位大臂沿 ±y 水平外展 -->
      <origin xyz="0 0 0" rpy="${sn*1.5707963267948966} 0 0"/>
      <parent link="${side}_arm_pitch_link"/>
      <child  link="${side}_arm_roll_link"/>
      <axis xyz="${sn} 0 0"/>
      <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
    </joint>

    <!-- arm_roll_link：上臂段（arm_upper_z） -->
    <link name="${side}_arm_roll_link">
      <visual>
        <origin xyz="0 0 ${-arm_upper_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_roll_box_len}"/>
        </geometry>
        <material name="arm_roll"/>
      </visual>
<collision>
        <origin xyz="0 0 ${-arm_upper_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_roll_box_len}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_arm_yaw_joint" type="revolute">
      <origin xyz="0 0 ${-arm_upper_z}" rpy="0 0 0"/>
      <parent link="${side}_arm_roll_link"/>
      <child  link="${side}_arm_yaw_link"/>
      <axis xyz="0 0 ${sn}"/>
      <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
    </joint>

    <!-- arm_yaw_link：下臂段（arm_lower_z） -->
    <link name="${side}_arm_yaw_link">
      <visual>
        <origin xyz="0 0 ${-arm_lower_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_yaw_box_len}"/>
        </geometry>
        <material name="arm_yaw"/>
      </visual>
<collision>
        <origin xyz="0 0 ${-arm_lower_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_yaw_box_len}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_elbow_joint" type="revolute">
      <!-- rpy 清零：去除原折弯，默认手与前臂连成直线（展开） -->
      <origin xyz="0 0 ${-arm_lower_z}" rpy="0 0 0"/>
      <parent link="${side}_arm_yaw_link"/>
      <child  link="${side}_elbow_link"/>
      <axis xyz="0 ${-sn} 0"/>
      <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
    </joint>

    <!-- elbow_link：手（末端） -->
    <link name="${side}_elbow_link">
      <visual>
        <origin xyz="0 0 ${-arm_elbow_box_len/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_elbow_box_len}"/>
        </geometry>
        <material name="arm_elbow"/>
      </visual>
<collision>
        <origin xyz="0 0 ${-arm_elbow_box_len/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_elbow_box_len}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- base_link：躯干（含 4 个与躯干相连的 base 关节）           -->
  <!-- ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${shoulder_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_len_x} ${torso_wid_y} ${torso_hgt_z}"/>
      </geometry>
      <material name="torso_blue"/>
    </visual>
<collision>
      <origin xyz="0 0 ${shoulder_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_len_x} ${torso_wid_y} ${torso_hgt_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- 耳朵宏：生成 pitch_link + roll_joint + roll_link（两关节）  -->
  <!--   parent 为头顶的 head_roll_link；ear_pitch_joint 由外部定义  -->
  <!-- ============================================================ -->
  <xacro:macro name="ear_links" params="side sn">
    <!-- ear_pitch_link：空连杆（无 box，仅作两个 DOF 的中继节点，位于耳根） -->
    <link name="${side}_ear_pitch_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${joint_marker_size} ${joint_marker_size} ${joint_marker_size}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_ear_roll_joint" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${side}_ear_pitch_link"/>
      <child  link="${side}_ear_roll_link"/>
      <!-- 轴改 x：真正绕前后横轴 roll（耳朵左右倒伏/张开）；原 0 0 z 是 yaw -->
      <axis xyz="1 0 0"/>
      <limit lower="${ear_lim_min}" upper="${ear_lim_max}" effort="1.0" velocity="2"/>
    </joint>

    <!-- ear_roll_link：耳朵唯一 box，长度=耳全长 ear_len，从头顶竖直伸出 -->
    <link name="${side}_ear_roll_link">
      <visual>
        <origin xyz="0 0 ${ear_len/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${ear_thick_x} ${ear_width_y} ${ear_len}"/>
        </geometry>
        <material name="ear_yellow"/>
      </visual>
<collision>
        <origin xyz="0 0 ${ear_len/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${ear_thick_x} ${ear_width_y} ${ear_len}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- 头部：pitch → yaw → roll 三段关节（原 head_joint 拆成 3 DOF）  -->
  <!--   三段共用 head_lim_* 限位；头大 box 挂在末端 head_roll_link -->
  <!-- ============================================================ -->
  <joint name="head_pitch_joint" type="revolute">
    <origin xyz="0 0 ${shoulder_height + head_bottom_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="head_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${head_lim_min}" upper="${head_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- head_pitch_link：空连杆（无 box，仅作 pitch→yaw 两级 DOF 的中继） -->
  <link name="head_pitch_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${joint_marker_size} ${joint_marker_size} ${joint_marker_size}"/>
        </geometry>
      </collision>
    </link>

  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="head_pitch_link"/>
    <child  link="head_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${head_lim_min}" upper="${head_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <link name="head_yaw_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${joint_marker_size} ${joint_marker_size} ${joint_marker_size}"/>
        </geometry>
      </collision>
    </link>

  <joint name="head_roll_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="head_yaw_link"/>
    <child  link="head_roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="${head_lim_min}" upper="${head_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- head_roll_link：实心头（原 head_link 大 box，末端） -->
  <link name="head_roll_link">
    <visual>
      <origin xyz="0 0 ${head_hgt_z/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${head_len_x} ${head_wid_y} ${head_hgt_z}"/>
      </geometry>
      <material name="head_yellow"/>
    </visual>
<collision>
      <origin xyz="0 0 ${head_hgt_z/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${head_len_x} ${head_wid_y} ${head_hgt_z}"/>
      </geometry>
    </collision>
  </link>

  <!-- 左耳 / 右耳 pitch：head_roll_link → 耳（roll 由 ear_links 宏生成） -->
  <joint name="left_ear_pitch_joint" type="revolute">
    <origin xyz="0 ${ear_off_y} ${ear_root_z}" rpy="0 0 0"/>
    <parent link="head_roll_link"/>
    <child  link="left_ear_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${ear_lim_min}" upper="${ear_lim_max}" effort="1.0" velocity="2"/>
  </joint>
  <joint name="right_ear_pitch_joint" type="revolute">
    <origin xyz="0 ${-ear_off_y} ${ear_root_z}" rpy="0 0 0"/>
    <parent link="head_roll_link"/>
    <child  link="right_ear_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${ear_lim_min}" upper="${ear_lim_max}" effort="1.0" velocity="2"/>
  </joint>

  <!-- ============================================================ -->
  <!-- 尾巴：tail_pitch → tail_yaw 两关节（躯干背面伸出）             -->
  <!-- ============================================================ -->
  <joint name="tail_pitch_joint" type="revolute">
    <origin xyz="${tail_root_x} 0 ${tail_root_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="tail_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${tail_lim_min}" upper="${tail_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- tail_pitch_link：空连杆（无 box，仅作两个 DOF 的中继节点，位于尾根） -->
  <link name="tail_pitch_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${joint_marker_size} ${joint_marker_size} ${joint_marker_size}"/>
        </geometry>
      </collision>
    </link>

  <joint name="tail_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="tail_pitch_link"/>
    <child  link="tail_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${tail_lim_min}" upper="${tail_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- tail_yaw_link：简化尾 box，沿 -x 伸出；可视与碰撞几何严格一致 -->
  <link name="tail_yaw_link">
    <visual>
      <origin xyz="${-tail_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${tail_len} ${tail_wid} ${tail_thick}"/>
      </geometry>
      <material name="tail_brown"/>
    </visual>
<collision>
      <origin xyz="${-tail_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${tail_len} ${tail_wid} ${tail_thick}"/>
      </geometry>
    </collision>
  </link>

  <!-- 髋 pitch：型→left_hip_pitch_link / right_hip_pitch_link -->
  <joint name="left_hip_pitch_joint" type="revolute">
    <origin xyz="0 ${hip_width - hip_pitch_to_roll_y} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="left_hip_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.44" effort="12.5" velocity="2"/>
  </joint>
  <joint name="right_hip_pitch_joint" type="revolute">
    <origin xyz="0 ${hip_pitch_to_roll_y - hip_width} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="right_hip_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.44" effort="12.5" velocity="2"/>
  </joint>

  <!-- 臂 pitch：型→left/right_arm_pitch_link（固定，抬升 shoulder_height） -->
  <joint name="left_arm_pitch_joint" type="revolute">
    <origin xyz="${arm_x_offset} ${arm_y_offset} ${shoulder_height}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="left_arm_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <joint name="right_arm_pitch_joint" type="revolute">
    <origin xyz="${arm_x_offset} ${-arm_y_offset} ${shoulder_height}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="right_arm_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
  </joint>

  <!-- ============================================================ -->
  <!-- 组装：左腿 / 右腿 / 左臂 / 右臂                           -->
  <!-- ============================================================ -->
  <xacro:leg_links side="left"  sn="1"></xacro:leg_links>
  <xacro:leg_links side="right" sn="-1"></xacro:leg_links>

  <xacro:arm_links side="left"  sn="1"></xacro:arm_links>
  <xacro:arm_links side="right" sn="-1"></xacro:arm_links>

  <xacro:ear_links side="left"  sn="1"></xacro:ear_links>
  <xacro:ear_links side="right" sn="-1"></xacro:ear_links>

</robot>
