    <inertial><origin xyz="0.000000000 0.000000000 -0.015000000" rpy="0.000000000 0.000000000 0.000000000"/><mass value="0.04050"/><inertia ixx="0.000006" iyy="0.000006" izz="0.000006" ixy="0" ixz="0" iyz="0"/></inertial></link>
  
  
    <!-- arm_pitch_link：覆盖到 roll 的横向(y)段 -->
    <link name="right_arm_pitch_link">
      <visual>
        <origin xyz="0 -0.0245 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.049 0.03"/>
