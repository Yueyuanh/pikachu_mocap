    <inertial><origin xyz="0.000000000 0.000000000 -0.010500000" rpy="0.000000000 0.000000000 0.000000000"/><mass value="0.02835"/><inertia ixx="0.000003" iyy="0.000003" izz="0.000004" ixy="0" ixz="0" iyz="0"/></inertial></link>

    <joint name="left_elbow_joint" type="revolute">
      <origin xyz="0 0 -0.021" rpy="0 -1.57 0"/>
      <parent link="left_arm_yaw_link"/>
      <child link="left_elbow_link"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.57" upper="1.57" effort="2.0" velocity="2"/>
    </joint>

    <!-- elbow_link：手（末端） -->
    <link name="left_elbow_link">
      <visual>
        <origin xyz="0 0 -0.015" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 0.03"/>
        </geometry>
        <material name="arm_elbow"/>
