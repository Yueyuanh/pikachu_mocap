<?xml version="1.0"?>
<!-- ============================================================================
  Pikachu_V025 简化模型 —— 纯 box 连杆，无 mesh
  ============================================================================
  · 层级、关节原点(xyz/rpy)、旋转轴 均严格对应 urdf/Pikachu_V025.urdf
  · 每个连杆用 <box> 表示，尺寸/偏移全部参数化，改顶部参数即可整体适配骨骼
  · 单位：米 (m)

  与原始 URDF 的对应总表：
    base_link           → 躯干
    left/right_hip_pitch→hip_roll   原点沿 y (横向) 偏移 hip_pitch_to_roll_y
    left/right_hip_roll →hip_yaw    原点沿 -z 偏移 hip_roll_to_yaw_z
    left/right_hip_yaw  →knee       原点沿 -z 偏移 thigh_length   （大腿）
    left/right_knee     →ankle      原点沿 -z 偏移 shank_length   （小腿）
    left/right_arm_pitch→roll       可动(revolute)，沿 y 偏移 arm_pitch_to_roll_y
    left/right_arm_roll →yaw        可动(revolute)，沿 -z 偏移 arm_upper_z
    left/right_arm_yaw  →elbow      可动(revolute)，沿 -z 偏移 arm_lower_z
    base_link → head_pitch→yaw→roll 头部三段(3 DOF：pitch点头 / yaw转头 / roll歪头)，
                                    立在躯干顶 shoulder_height 之上
    head_roll_link → 左/右耳  ear_pitch→ear_roll（每耳 2 DOF，头顶两侧）
    base_link → 尾巴         tail_pitch→tail_yaw（2 DOF，躯干背面伸出）

    DOF 合计：腿 10 + 臂 8 + 头 3 + 耳 4 + 尾 2 = 27
    注：臂 pitch/roll/yaw/elbow 与 head 原本为 fixed，这里改成 revolute 以便驱动；
        限位由 arm_lim_* / head_lim_* 控制。
============================================================================ -->
<robot name="pikachu_sample_links" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- 【集中参数区】改这里即可整体调整 / 适配骨骼模型              -->
  <!-- ============================================================ -->

  <!-- ==== 躯干 / 肩 ==== -->
  <xacro:property name="pelvis_half_width" value="0.0515"/>
    <!-- 骨盆半宽：躯干中轴线 → 髋 pitch 关节的横向(y)距离，左右腿共用 -->
  <xacro:property name="shoulder_height"   value="0.2"/>
    <!-- 肩高：髋 pitch 平面 → 臂 pitch 关节的 z 抬升（也是躯干盒高度） -->
  <xacro:property name="torso_len_x"       value="0.08"/>
    <!-- 躯干盒 x(前后) 厚度 -->
  <!-- 躯干盒 y(左右) 宽度已绑定 pelvis_half_width*2：随骨盆联动，
       避免调整髋半宽时躯干不跟着加宽、两侧腿像架空一样 -->

  <!-- ==== 腿：骨盆横向/侧段（左右方向，一般不调） ==== -->
  <xacro:property name="hip_pitch_to_roll_y" value="0.0355"/>
    <!-- hip_pitch→hip_roll 关节沿 y 偏移 -->
  <xacro:property name="hip_roll_to_yaw_z"   value="0.046"/>
    <!-- hip_roll→hip_yaw 关节沿 -z 偏移（骨盆下沿） -->

  <!-- ==== 【腿纵向骨长】适配骨骼时重点调这两项 ==== -->
  <xacro:property name="thigh_length" value="0.025"/>
    <!-- 大腿：hip_yaw→knee 关节 沿 -z 偏移（也是该段 box 的长度） -->
  <xacro:property name="shank_length" value="0.070"/>
    <!-- 小腿：knee→ankle 关节 沿 -z 偏移（也是该段 box 的长度） -->

  <!-- ==== 腿截面尺寸 ==== -->
  <xacro:property name="leg_thick_x" value="0.04"/>
    <!-- 腿 box 的 x(前后) 厚 -->
  <xacro:property name="leg_width_y" value="0.025"/>
    <!-- 腿 box 的 y(内外) 厚 -->

  <!-- ==== 脚 ==== -->
  <xacro:property name="foot_len_x" value="0.08"/>
  <xacro:property name="foot_wid_y" value="0.05"/>
  <xacro:property name="foot_hgt_z" value="0.02"/>

  <!-- ==== 臂（fixed，不会动，只做占位） ==== -->
  <xacro:property name="arm_pitch_to_roll_y" value="0.049"/>
    <!-- 臂 pitch→roll 沿 y 偏移 -->
  <xacro:property name="arm_upper_z" value="0.051"/>
    <!-- 臂 roll 段：沿 -z 偏移 / 长度 -->
  <xacro:property name="arm_lower_z" value="0.021"/>
    <!-- 臂 yaw 段：沿 -z 偏移 / 长度 -->
  <xacro:property name="arm_thick_x" value="0.03"/>
  <xacro:property name="arm_width_y" value="0.03"/>

  <!-- ==== 头（原始 URDF 没有，适配骨骼时按需调整） ==== -->
  <xacro:property name="head_len_x"         value="0.09"/>
    <!-- 头 x(前后) 尺寸 -->
  <xacro:property name="head_wid_y"         value="0.11"/>
    <!-- 头 y(左右) 尺寸 -->
  <xacro:property name="head_hgt_z"         value="0.12"/>
    <!-- 头 z(上下) 尺寸 -->
  <xacro:property name="head_bottom_offset" value="0.0"/>
    <!-- 头底部 相对躯干顶(z=shoulder_height) 的额外抬升，>=0 -->

  <!-- ==== 手臂 / 头 关节限位（把 fixed 改成 revolute 后可驱动） ==== -->
  <xacro:property name="arm_lim_min" value="-1.57"/>
    <!-- 臂 pitch/roll/yaw/elbow 的关节下限（弧度） -->
  <xacro:property name="arm_lim_max" value="1.57"/>
    <!-- 臂 pitch/roll/yaw/elbow 的关节上限（弧度） -->
  <xacro:property name="head_lim_min" value="-0.8"/>
    <!-- 头关节下限（弧度） -->
  <xacro:property name="head_lim_max" value="0.8"/>
    <!-- 头关节上限（弧度） -->

  <!-- ==== 耳朵（左右各 pitch+roll 两关节，从头顶两侧伸出） ==== -->
  <xacro:property name="ear_off_y"       value="0.045"/>
    <!-- 耳朵 相对头中心 的横向(y)偏移，左右耳反对称 -->
  <xacro:property name="ear_len"         value="0.085"/>
    <!-- 耳全长（单段 box，从头顶 +z 伸出，到耳尖） -->
  <xacro:property name="ear_thick_x"     value="0.018"/>
    <!-- 耳 x(前后) 厚 -->
  <xacro:property name="ear_width_y"     value="0.028"/>
    <!-- 耳 y(左右) 宽 -->
  <xacro:property name="ear_lim_min"     value="-0.6"/>
    <!-- 耳关节下限（弧度） -->
  <xacro:property name="ear_lim_max"     value="0.8"/>
    <!-- 耳关节上限（弧度） -->
  <xacro:property name="mat_ear"         value="0.95 0.78 0.25 1"/>
    <!-- 耳朵：亮黄 -->

  <!-- ==== 尾巴（pitch+yaw 两关节，从躯干背面伸出） ==== -->
  <xacro:property name="tail_root_z"     value="0.06"/>
    <!-- 尾根 相对躯干底(z=0) 的高度 -->
  <xacro:property name="tail_len"        value="0.095"/>
    <!-- 尾全长（单段 box，沿 -x 从躯干后表面伸出，到尾尖） -->
  <xacro:property name="tail_wid"        value="0.05"/>
    <!-- 尾 y(左右) 宽（扁） -->
  <xacro:property name="tail_thick"      value="0.02"/>
    <!-- 尾 z(上下) 厚 -->
  <xacro:property name="tail_lim_min"    value="-1.2"/>
    <!-- 尾关节下限（弧度） -->
  <xacro:property name="tail_lim_max"    value="1.2"/>
    <!-- 尾关节上限（弧度） -->
  <xacro:property name="mat_tail"        value="0.55 0.38 0.18 1"/>
    <!-- 尾巴：棕 -->

  <!-- ==== 材质（仅便于视觉区分；相邻关节用不同色，左右对称） ==== -->
  <xacro:property name="mat_torso"   value="0.55 0.60 0.75 1"/>
    <!-- 躯干：淡蓝灰 -->
  <xacro:property name="mat_head"    value="0.98 0.85 0.30 1"/>
    <!-- 头：亮黄 -->
  <xacro:property name="mat_leg_hip_pitch" value="0.90 0.35 0.80 1"/>
    <!-- 腿段A(hip_pitch)：品红 -->
  <xacro:property name="mat_leg_hip_roll"  value="1.00 0.60 0.20 1"/>
    <!-- 腿段B(hip_roll)：橙 -->
  <xacro:property name="mat_leg_hip_yaw"   value="0.35 0.55 1.00 1"/>
    <!-- 腿段C(hip_yaw 大腿)：蓝 -->
  <xacro:property name="mat_leg_knee"      value="0.30 0.80 0.35 1"/>
    <!-- 腿段D(knee 小腿)：绿 -->
  <xacro:property name="mat_leg_ankle"     value="0.25 0.28 0.35 1"/>
    <!-- 腿段E(ankle 脚)：深灰蓝 -->
  <xacro:property name="mat_arm_pitch"     value="0.75 0.35 1.00 1"/>
    <!-- 臂段A(arm_pitch 肩)：紫 -->
  <xacro:property name="mat_arm_roll"      value="1.00 0.90 0.25 1"/>
    <!-- 臂段B(arm_roll 上臂)：黄 -->
  <xacro:property name="mat_arm_yaw"       value="0.30 0.85 0.80 1"/>
    <!-- 臂段C(arm_yaw 下臂)：青 -->
  <xacro:property name="mat_arm_elbow"     value="1.00 0.45 0.55 1"/>
    <!-- 臂段D(elbow 手)：珊瑚 -->

  <!-- ============================================================ -->
  <!-- 材质定义（每段独立颜色，左右对称共用同一套）              -->
  <!-- ============================================================ -->
  <material name="torso_blue">
    <color rgba="${mat_torso}"/>
  </material>
  <material name="head_yellow">
    <color rgba="${mat_head}"/>
  </material>
  <material name="leg_hip_pitch">
    <color rgba="${mat_leg_hip_pitch}"/>
  </material>
  <material name="leg_hip_roll">
    <color rgba="${mat_leg_hip_roll}"/>
  </material>
  <material name="leg_hip_yaw">
    <color rgba="${mat_leg_hip_yaw}"/>
  </material>
  <material name="leg_knee">
    <color rgba="${mat_leg_knee}"/>
  </material>
  <material name="leg_ankle">
    <color rgba="${mat_leg_ankle}"/>
  </material>
  <material name="arm_pitch">
    <color rgba="${mat_arm_pitch}"/>
  </material>
  <material name="arm_roll">
    <color rgba="${mat_arm_roll}"/>
  </material>
  <material name="arm_yaw">
    <color rgba="${mat_arm_yaw}"/>
  </material>
  <material name="arm_elbow">
    <color rgba="${mat_arm_elbow}"/>
  </material>
  <material name="ear_yellow">
    <color rgba="${mat_ear}"/>
  </material>
  <material name="tail_brown">
    <color rgba="${mat_tail}"/>
  </material>

  <!-- ============================================================ -->
  <!-- 腿部宏：生成 pitch/roll/yaw/knee/ankle 五个 link             -->
  <!--   side: left | right     sn:  1 | -1（y 方向符号）      -->
  <!-- ============================================================ -->
  <xacro:macro name="leg_links" params="side sn">
    <!-- hip_pitch_link：覆盖到 roll 的横向(y)段 -->
    <link name="${side}_hip_pitch_link">
      <visual>
        <origin xyz="0 ${sn*hip_pitch_to_roll_y/2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${hip_pitch_to_roll_y} ${leg_width_y}"/>
        </geometry>
        <material name="leg_hip_pitch"/>
      </visual>
    </link>

    <joint name="${side}_hip_roll_joint" type="revolute">
      <origin xyz="0 ${sn*hip_pitch_to_roll_y} 0" rpy="0 0 0"/>
      <parent link="${side}_hip_pitch_link"/>
      <child  link="${side}_hip_roll_link"/>
      <axis xyz="${sn} 0 0"/>
      <limit lower="-0.09" upper="0.26" effort="9.0" velocity="1"/>
    </joint>

    <!-- hip_roll_link：覆盖到 yaw 的 -z 骨盆段 -->
    <link name="${side}_hip_roll_link">
      <visual>
        <origin xyz="0 0 ${-hip_roll_to_yaw_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${hip_roll_to_yaw_z}"/>
        </geometry>
        <material name="leg_hip_roll"/>
      </visual>
    </link>

    <joint name="${side}_hip_yaw_joint" type="revolute">
      <origin xyz="0 0 ${-hip_roll_to_yaw_z}" rpy="0 0 0"/>
      <parent link="${side}_hip_roll_link"/>
      <child  link="${side}_hip_yaw_link"/>
      <axis xyz="0 0 ${sn}"/>
      <limit lower="-0.09" upper="0.26" effort="9.0" velocity="1"/>
    </joint>

    <!-- hip_yaw_link：大腿段（thigh_length） -->
    <link name="${side}_hip_yaw_link">
      <visual>
        <origin xyz="0 0 ${-thigh_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${thigh_length}"/>
        </geometry>
        <material name="leg_hip_yaw"/>
      </visual>
    </link>

    <joint name="${side}_knee_joint" type="revolute">
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
      <parent link="${side}_hip_yaw_link"/>
      <child  link="${side}_knee_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.57" effort="12.5" velocity="3"/>
    </joint>

    <!-- knee_link：小腿段（shank_length） -->
    <link name="${side}_knee_link">
      <visual>
        <origin xyz="0 0 ${-shank_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_thick_x} ${leg_width_y} ${shank_length}"/>
        </geometry>
        <material name="leg_knee"/>
      </visual>
    </link>

    <joint name="${side}_ankle_joint" type="revolute">
      <origin xyz="0 0 ${-shank_length}" rpy="0 0 0"/>
      <parent link="${side}_knee_link"/>
      <child  link="${side}_ankle_link"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-0.52" upper="1.05" effort="9.0" velocity="2"/>
    </joint>

    <!-- ankle_link：脚掌（末端） -->
    <link name="${side}_ankle_link">
      <visual>
        <origin xyz="${foot_len_x/6.0} 0 ${-foot_hgt_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${foot_len_x} ${foot_wid_y} ${foot_hgt_z}"/>
        </geometry>
        <material name="leg_ankle"/>
      </visual>
    </link>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- 手臂宏：生成 pitch/roll/yaw/elbow 四个 link（全部 revolute 可动） -->
  <!-- ============================================================ -->
  <xacro:macro name="arm_links" params="side sn">
    <!-- arm_pitch_link：覆盖到 roll 的横向(y)段 -->
    <link name="${side}_arm_pitch_link">
      <visual>
        <origin xyz="0 ${sn*arm_pitch_to_roll_y/2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_pitch_to_roll_y} ${arm_width_y}"/>
        </geometry>
        <material name="arm_pitch"/>
      </visual>
    </link>

    <joint name="${side}_arm_roll_joint" type="revolute">
      <origin xyz="0 ${sn*arm_pitch_to_roll_y} 0" rpy="0 0 0"/>
      <parent link="${side}_arm_pitch_link"/>
      <child  link="${side}_arm_roll_link"/>
      <axis xyz="${sn} 0 0"/>
      <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
    </joint>

    <!-- arm_roll_link：上臂段（arm_upper_z） -->
    <link name="${side}_arm_roll_link">
      <visual>
        <origin xyz="0 0 ${-arm_upper_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_upper_z}"/>
        </geometry>
        <material name="arm_roll"/>
      </visual>
    </link>

    <joint name="${side}_arm_yaw_joint" type="revolute">
      <origin xyz="0 0 ${-arm_upper_z}" rpy="0 0 0"/>
      <parent link="${side}_arm_roll_link"/>
      <child  link="${side}_arm_yaw_link"/>
      <axis xyz="0 0 ${sn}"/>
      <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
    </joint>

    <!-- arm_yaw_link：下臂段（arm_lower_z） -->
    <link name="${side}_arm_yaw_link">
      <visual>
        <origin xyz="0 0 ${-arm_lower_z/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_lower_z}"/>
        </geometry>
        <material name="arm_yaw"/>
      </visual>
    </link>

    <joint name="${side}_elbow_joint" type="revolute">
      <origin xyz="0 0 ${-arm_lower_z}" rpy="0 -1.57 0"/>
      <parent link="${side}_arm_yaw_link"/>
      <child  link="${side}_elbow_link"/>
      <axis xyz="0 ${-sn} 0"/>
      <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
    </joint>

    <!-- elbow_link：手（末端） -->
    <link name="${side}_elbow_link">
      <visual>
        <origin xyz="0 0 ${-arm_thick_x/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thick_x} ${arm_width_y} ${arm_thick_x}"/>
        </geometry>
        <material name="arm_elbow"/>
      </visual>
    </link>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- base_link：躯干（含 4 个与躯干相连的 base 关节）           -->
  <!-- ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${shoulder_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_len_x} ${pelvis_half_width*2} ${shoulder_height}"/>
      </geometry>
      <material name="torso_blue"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!-- 耳朵宏：生成 pitch_link + roll_joint + roll_link（两关节）  -->
  <!--   parent 为头顶的 head_roll_link；ear_pitch_joint 由外部定义  -->
  <!-- ============================================================ -->
  <xacro:macro name="ear_links" params="side sn">
    <!-- ear_pitch_link：空连杆（无 box，仅作两个 DOF 的中继节点，位于耳根） -->
    <link name="${side}_ear_pitch_link"/>

    <joint name="${side}_ear_roll_joint" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${side}_ear_pitch_link"/>
      <child  link="${side}_ear_roll_link"/>
      <axis xyz="0 0 ${sn}"/>
      <limit lower="${ear_lim_min}" upper="${ear_lim_max}" effort="1.0" velocity="2"/>
    </joint>

    <!-- ear_roll_link：耳朵唯一 box，长度=耳全长 ear_len，从头顶竖直伸出 -->
    <link name="${side}_ear_roll_link">
      <visual>
        <origin xyz="0 0 ${ear_len/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${ear_thick_x} ${ear_width_y} ${ear_len}"/>
        </geometry>
        <material name="ear_yellow"/>
      </visual>
    </link>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- 头部：pitch → yaw → roll 三段关节（原 head_joint 拆成 3 DOF）  -->
  <!--   三段共用 head_lim_* 限位；头大 box 挂在末端 head_roll_link -->
  <!-- ============================================================ -->
  <joint name="head_pitch_joint" type="revolute">
    <origin xyz="0 0 ${shoulder_height + head_bottom_offset + head_hgt_z/2.0}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="head_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${head_lim_min}" upper="${head_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- head_pitch_link：空连杆（无 box，仅作 pitch→yaw 两级 DOF 的中继） -->
  <link name="head_pitch_link"/>

  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="head_pitch_link"/>
    <child  link="head_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${head_lim_min}" upper="${head_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <link name="head_yaw_link"/>

  <joint name="head_roll_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="head_yaw_link"/>
    <child  link="head_roll_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="${head_lim_min}" upper="${head_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- head_roll_link：实心头（原 head_link 大 box，末端） -->
  <link name="head_roll_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${head_len_x} ${head_wid_y} ${head_hgt_z}"/>
      </geometry>
      <material name="head_yellow"/>
    </visual>
  </link>

  <!-- 左耳 / 右耳 pitch：head_roll_link → 耳（roll 由 ear_links 宏生成） -->
  <joint name="left_ear_pitch_joint" type="revolute">
    <origin xyz="0 ${ear_off_y} ${head_hgt_z/2.0}" rpy="0 0 0"/>
    <parent link="head_roll_link"/>
    <child  link="left_ear_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${ear_lim_min}" upper="${ear_lim_max}" effort="1.0" velocity="2"/>
  </joint>
  <joint name="right_ear_pitch_joint" type="revolute">
    <origin xyz="0 ${-ear_off_y} ${head_hgt_z/2.0}" rpy="0 0 0"/>
    <parent link="head_roll_link"/>
    <child  link="right_ear_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${ear_lim_min}" upper="${ear_lim_max}" effort="1.0" velocity="2"/>
  </joint>

  <!-- ============================================================ -->
  <!-- 尾巴：tail_pitch → tail_yaw 两关节（躯干背面伸出）             -->
  <!-- ============================================================ -->
  <joint name="tail_pitch_joint" type="revolute">
    <origin xyz="${-torso_len_x/2.0} 0 ${tail_root_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="tail_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${tail_lim_min}" upper="${tail_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- tail_pitch_link：空连杆（无 box，仅作两个 DOF 的中继节点，位于尾根） -->
  <link name="tail_pitch_link"/>

  <joint name="tail_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="tail_pitch_link"/>
    <child  link="tail_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${tail_lim_min}" upper="${tail_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <!-- tail_yaw_link：尾巴唯一 box，长度=尾全长 tail_len，沿 -x 从躯干背面伸出 -->
  <link name="tail_yaw_link">
    <visual>
      <origin xyz="${-tail_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${tail_len} ${tail_wid} ${tail_thick}"/>
      </geometry>
      <material name="tail_brown"/>
    </visual>
  </link>

  <!-- 髋 pitch：型→left_hip_pitch_link / right_hip_pitch_link -->
  <joint name="left_hip_pitch_joint" type="revolute">
    <origin xyz="0 ${pelvis_half_width} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="left_hip_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.44" effort="12.5" velocity="2"/>
  </joint>
  <joint name="right_hip_pitch_joint" type="revolute">
    <origin xyz="0 ${-pelvis_half_width} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="right_hip_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.44" effort="12.5" velocity="2"/>
  </joint>

  <!-- 臂 pitch：型→left/right_arm_pitch_link（固定，抬升 shoulder_height） -->
  <joint name="left_arm_pitch_joint" type="revolute">
    <origin xyz="0 ${pelvis_half_width} ${shoulder_height}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="left_arm_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
  </joint>
  <joint name="right_arm_pitch_joint" type="revolute">
    <origin xyz="0 ${-pelvis_half_width} ${shoulder_height}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="right_arm_pitch_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${arm_lim_min}" upper="${arm_lim_max}" effort="2.0" velocity="2"/>
  </joint>

  <!-- ============================================================ -->
  <!-- 组装：左腿 / 右腿 / 左臂 / 右臂                           -->
  <!-- ============================================================ -->
  <xacro:leg_links side="left"  sn="1"></xacro:leg_links>
  <xacro:leg_links side="right" sn="-1"></xacro:leg_links>

  <xacro:arm_links side="left"  sn="1"></xacro:arm_links>
  <xacro:arm_links side="right" sn="-1"></xacro:arm_links>

  <xacro:ear_links side="left"  sn="1"></xacro:ear_links>
  <xacro:ear_links side="right" sn="-1"></xacro:ear_links>

</robot>